# Backend API (see server/) - Node/Express + PostgreSQL
VITE_API_URL=http://localhost:4000/api

# Cloudinary Storage Configuration
# Uploads are unsigned (browser-only app, no backend to hold a secret safely).
# Create an unsigned upload preset in the Cloudinary console:
# Settings -> Upload -> Upload presets -> Add upload preset -> Signing mode: Unsigned
VITE_CLOUDINARY_CLOUD_NAME=je6whpaq
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name_here
