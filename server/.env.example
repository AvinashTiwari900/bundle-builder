# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ras?schema=public"

# Secret used to sign JWTs - generate a long random value for real deployments
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000

# Comma-separated list of frontend origins allowed to call this API with credentials
FRONTEND_ORIGINS="http://localhost:5173"

NODE_ENV=development
